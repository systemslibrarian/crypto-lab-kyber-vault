{
  "name": "kyber-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lighthouse": "vite build --base / --outDir lighthouse-dist",
    "audit": "npm audit --audit-level=moderate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-kyber-vault --ref main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "sbom": "npm sbom --sbom-format cyclonedx"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "happy-dom": "^20.14.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1"
  }
}
